table avance_real
	lineageTag: aab80230-f5b8-4f8e-b515-3b3f0d2acb53

	measure 'Avance Real Curva S' =
			
			VAR FechaEvaluacion =
			    MAX('Calendario'[Date])
			
			VAR FechaInicioProyecto =
			    CALCULATE(
			        MIN('cronograma_darca2'[BaselineStart]),
			        FILTER(
			            ALL('cronograma_darca2'),
			            'cronograma_darca2'[BaselineStart] <> BLANK()
			        )
			    )
			
			VAR EsFechaCorteReal =
			    CALCULATE(
			        COUNTROWS('avance_real'),
			        FILTER(
			            ALL('avance_real'),
			            'avance_real'[Fecha Corte] = FechaEvaluacion
			        )
			    ) > 0
			
			VAR AvanceEnFecha =
			    CALCULATE(
			        [Avance Real Total],
			        FILTER(
			            ALL('avance_real'[Fecha Corte]),
			            'avance_real'[Fecha Corte] <= FechaEvaluacion
			        )
			    )
			
			RETURN
			SWITCH(
			    TRUE(),
			
			    FechaEvaluacion = INT(FechaInicioProyecto),
			        0,
			
			    EsFechaCorteReal,
			        AvanceEnFecha,
			
			    BLANK()
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 59005a3a-739e-42c4-b579-3fe24033ecf7

	measure 'Proyección Curva S' =
			
			VAR FechaEnEje = MAX('Calendario'[Date])
			VAR FechaCorte = DATE(2026, 10, 3)
			VAR AvanceCorte = 0.5327
			VAR PendienteDiaria = 0.0121715008
			VAR DiasDesdeCorte =
			    DATEDIFF(FechaCorte, FechaEnEje, DAY)
			RETURN
			    IF(
			        FechaEnEje < FechaCorte,
			        BLANK(),
			        MIN(1, AvanceCorte + PendienteDiaria * DiasDesdeCorte)
			    )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: cc889cb6-f1fc-4cad-95e2-7d253aa8e90c

	column 'Fecha Corte'
		dataType: dateTime
		formatString: Short Date
		lineageTag: f568bd8e-f165-4030-a9d1-de163f6e3e4a
		summarizeBy: none
		sourceColumn: Fecha Corte

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

