	partition cronograma_darca2 = m
		mode: import
		source =
				let
				    Source = Csv.Document(
				        File.Contents("C:\Datos\Demo\output\cronograma_darca2.csv"),
				        [
				            Delimiter=";",
				            Columns=49,
				            Encoding=65001,
				            QuoteStyle=QuoteStyle.Csv
				        ]
				    ),
				
				    #"Promoted Headers" =
				        Table.PromoteHeaders(
				            Source,
				            [PromoteAllScalars=true]
				        ),
				
				    #"Numeric Types en-US" =
				        Table.TransformColumnTypes(
				            #"Promoted Headers",
				            {
				                {"HoursPerDay", type number},
				                {"HoursPerWeek", type number},
				                {"MinutesPerDay", type number},
				                {"MinutesPerWeek", type number},
				
				                {"ID", Int64.Type},
				                {"UniqueID", Int64.Type},
				                {"OutlineLevel", Int64.Type},
				
				                {"DurationMinutes", type number},
				                {"DurationDays", type number},
				
				                {"BaselineDurationMinutes", type number},
				                {"BaselineDurationDays", type number},
				
				                {"PercentComplete", type number},
				                {"PhysicalPercentComplete", type number},
				
				                {"ActualDurationMinutes", type number},
				                {"ActualDurationDays", type number},
				
				                {"RemainingDurationMinutes", type number},
				                {"RemainingDurationDays", type number},
				
				                {"TotalSlackMinutes", type number},
				                {"TotalSlackDays", type number},
				
				                {"FreeSlackMinutes", type number},
				                {"FreeSlackDays", type number},
				
				                {"WorkMinutes", type number},
				                {"ActualWorkMinutes", type number},
				                {"RemainingWorkMinutes", type number},
				                {"BaselineWorkMinutes", type number},
				
				                {"Cost", type number},
				                {"BaselineCost", type number}
				            },
				            "en-US"
				        ),
				    #"Changed Type with Locale" = Table.TransformColumnTypes(#"Numeric Types en-US", {{"Start", type datetime}, {"Finish", type datetime}}, "es-CO"),
				    #"Changed Type" = Table.TransformColumnTypes(#"Changed Type with Locale",{{"BaselineStart", type datetime}, {"BaselineFinish", type datetime}}),
				
				    #"Boolean Types" =
				        Table.TransformColumnTypes(
				            #"Changed Type",
				            {
				                {"Critical", type logical},
				                {"Summary", type logical},
				                {"Milestone", type logical},
				                {"Active", type logical},
				                {"BaselineAvailable", type logical}
				            }
				        ),
				    #"Text Types" =
				        Table.TransformColumnTypes(
				            #"Boolean Types",
				            {
				                {"ProjectName", type text},
				                {"WBS", type text},
				                {"TaskName", type text},
				                {"Predecessors", type text},
				                {"Successors", type text},
				                {"ConstraintType", type text},
				                {"ConstraintTypeName", type text}
				            }
				        )
				in
				    #"Text Types"

