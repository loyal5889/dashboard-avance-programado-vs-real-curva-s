table cronograma_darca2
	lineageTag: 1b03c0f0-7ebf-4a42-b228-8c4610076e23

	measure 'Duración Total Ponderable' =
			
			CALCULATE(
			    SUM('cronograma_darca2'[BaselineDurationDays]),
			    'cronograma_darca2'[Summary] = FALSE(),
			    'cronograma_darca2'[Milestone] = FALSE(),
			    'cronograma_darca2'[Active] = TRUE(),
			    'cronograma_darca2'[BaselineDurationDays] > 0
			)
		lineageTag: 44b2a398-ea28-43b4-88b1-1c31c303590e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Fecha Corte' =
			
			TODAY()
		formatString: Short Date
		lineageTag: 7e641d13-7e68-447e-aaaa-97ef71d8ec92

	measure 'Peso Actividad' =
			
			VAR EsFilaActividad =
			    ISINSCOPE('cronograma_darca2'[Actividad Project])
			
			VAR DuracionActividad =
			    SELECTEDVALUE('cronograma_darca2'[BaselineDurationDays])
			
			VAR EsActividadValida =
			    SELECTEDVALUE('cronograma_darca2'[Summary]) = FALSE()
			        && SELECTEDVALUE('cronograma_darca2'[Milestone]) = FALSE()
			        && SELECTEDVALUE('cronograma_darca2'[Active]) = TRUE()
			        && DuracionActividad > 0
			
			VAR DuracionTotal =
			    CALCULATE(
			        SUM('cronograma_darca2'[BaselineDurationDays]),
			        FILTER(
			            ALL('cronograma_darca2'),
			            'cronograma_darca2'[Summary] = FALSE()
			                && 'cronograma_darca2'[Milestone] = FALSE()
			                && 'cronograma_darca2'[Active] = TRUE()
			                && 'cronograma_darca2'[BaselineDurationDays] > 0
			        )
			    )
			
			RETURN
			IF(
			    NOT EsFilaActividad,
			    1,
			    IF(
			        NOT EsActividadValida,
			        BLANK(),
			        DIVIDE(DuracionActividad, DuracionTotal, 0)
			    )
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: e023ad4a-3154-4345-98fb-4bf097fbd749

	measure '% Programado Actividad' =
			
			VAR FechaCorte =
			    INT([Fecha Corte])
			
			VAR InicioBase =
			    INT(SELECTEDVALUE('cronograma_darca2'[BaselineStart]))
			
			VAR FinBase =
			    INT(SELECTEDVALUE('cronograma_darca2'[BaselineFinish]))
			
			VAR DuracionBase =
			    SELECTEDVALUE('cronograma_darca2'[BaselineDurationDays])
			
			VAR EsActividadValida =
			    SELECTEDVALUE('cronograma_darca2'[Summary]) = FALSE()
			        && SELECTEDVALUE('cronograma_darca2'[Milestone]) = FALSE()
			        && SELECTEDVALUE('cronograma_darca2'[Active]) = TRUE()
			        && DuracionBase > 0
			
			VAR DiasTranscurridos =
			    NETWORKDAYS(
			        InicioBase,
			        FechaCorte,
			        11
			    )
			
			VAR PorcentajeProgramado =
			    DIVIDE(
			        DiasTranscurridos,
			        DuracionBase,
			        0
			    )
			
			RETURN
			IF(
			    NOT EsActividadValida,
			    BLANK(),
			    SWITCH(
			        TRUE(),
			        FechaCorte < InicioBase, 0,
			        FechaCorte >= FinBase, 1,
			        MIN(1, MAX(0, PorcentajeProgramado))
			    )
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: d094b57e-0d64-4452-a739-5b6795a6645c

	measure 'Avance Programado Total' =
			
			SUMX(
			    FILTER(
			        ALL('cronograma_darca2'),
			        'cronograma_darca2'[Summary] = FALSE()
			            && 'cronograma_darca2'[Milestone] = FALSE()
			            && 'cronograma_darca2'[Active] = TRUE()
			            && 'cronograma_darca2'[BaselineDurationDays] > 0
			    ),
			    VAR DuracionActividad =
			        'cronograma_darca2'[BaselineDurationDays]
			
			    VAR DuracionTotal =
			        CALCULATE(
			            SUM('cronograma_darca2'[BaselineDurationDays]),
			            FILTER(
			                ALL('cronograma_darca2'),
			                'cronograma_darca2'[Summary] = FALSE()
			                    && 'cronograma_darca2'[Milestone] = FALSE()
			                    && 'cronograma_darca2'[Active] = TRUE()
			                    && 'cronograma_darca2'[BaselineDurationDays] > 0
			            )
			        )
			
			    VAR PesoActividad =
			        DIVIDE(
			            DuracionActividad,
			            DuracionTotal,
			            0
			        )
			
			    VAR InicioBase =
			        INT('cronograma_darca2'[BaselineStart])
			
			    VAR FinBase =
			        INT('cronograma_darca2'[BaselineFinish])
			
			    VAR FechaCorte =
			        INT([Fecha Corte])
			
			    VAR PorcentajeProgramado =
			        SWITCH(
			            TRUE(),
			            FechaCorte < InicioBase, 0,
			            FechaCorte >= FinBase, 1,
			            MIN(
			                1,
			                MAX(
			                    0,
			                    DIVIDE(
			                        NETWORKDAYS(
			                            InicioBase,
			                            FechaCorte,
			                            11
			                        ),
			                        DuracionActividad,
			                        0
			                    )
			                )
			            )
			        )
			
			    RETURN
			        PesoActividad * PorcentajeProgramado
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: b30d9dd7-103c-4c4d-9049-effa45034f63

	measure 'Aporte Programado' =
			
			IF(
			    ISINSCOPE('cronograma_darca2'[Actividad Project]),
			
			    [Peso Actividad] * [% Programado Actividad],
			
			    SUMX(
			        FILTER(
			            ALL('cronograma_darca2'),
			            'cronograma_darca2'[Summary] = FALSE()
			                && 'cronograma_darca2'[Milestone] = FALSE()
			                && 'cronograma_darca2'[Active] = TRUE()
			                && 'cronograma_darca2'[BaselineDurationDays] > 0
			        ),
			        VAR DuracionActividad =
			            'cronograma_darca2'[BaselineDurationDays]
			
			        VAR DuracionTotal =
			            CALCULATE(
			                SUM('cronograma_darca2'[BaselineDurationDays]),
			                FILTER(
			                    ALL('cronograma_darca2'),
			                    'cronograma_darca2'[Summary] = FALSE()
			                        && 'cronograma_darca2'[Milestone] = FALSE()
			                        && 'cronograma_darca2'[Active] = TRUE()
			                        && 'cronograma_darca2'[BaselineDurationDays] > 0
			                )
			            )
			
			        VAR Peso =
			            DIVIDE(DuracionActividad, DuracionTotal, 0)
			
			        RETURN
			            Peso * [% Programado Actividad]
			    )
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 1b53f069-7d7e-4017-9e73-1fe1809eacf5

