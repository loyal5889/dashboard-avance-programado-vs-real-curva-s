expression 'Errors in cronograma_darca2' =
		let
		Source = cronograma_darca2,
		  #"Detected Type Mismatches" = let
		    tableWithOnlyPrimitiveTypes = Table.SelectColumns(Source, Table.ColumnsOfType(Source, {type nullable number, type nullable text, type nullable logical, type nullable date, type nullable datetime, type nullable datetimezone, type nullable time, type nullable duration})),
		    recordTypeFields = Type.RecordFields(Type.TableRow(Value.Type(tableWithOnlyPrimitiveTypes))),
		    fieldNames = Record.FieldNames(recordTypeFields),
		    fieldTypes = List.Transform(Record.ToList(recordTypeFields), each [Type]),
		    pairs = List.Transform(List.Positions(fieldNames), (i) => {fieldNames{i}, (v) => if v = null or Value.Is(v, fieldTypes{i}) then v else error [Message = "The type of the value does not match the type of the column.", Detail = v], fieldTypes{i}})
		in
		    Table.TransformColumns(Source, pairs),
		  #"Added Index" = Table.AddIndexColumn(#"Detected Type Mismatches", "Row Number" ,1),
		  #"Kept Errors" = Table.SelectRowsWithErrors(#"Added Index", {"ProjectName", "ExtractionDate", "StatusDate", "HoursPerDay", "HoursPerWeek", "MinutesPerDay", "MinutesPerWeek", "ID", "UniqueID", "WBS", "OutlineLevel", "TaskName", "Start", "Finish", "DurationMinutes", "DurationDays", "BaselineStart", "BaselineFinish", "BaselineDurationMinutes", "BaselineDurationDays", "PercentComplete", "PhysicalPercentComplete", "ActualStart", "ActualFinish", "ActualDurationMinutes", "ActualDurationDays", "RemainingDurationMinutes", "RemainingDurationDays", "Predecessors", "Successors", "TotalSlackMinutes", "TotalSlackDays", "FreeSlackMinutes", "FreeSlackDays", "Critical", "Summary", "Milestone", "Active", "ConstraintType", "ConstraintTypeName", "ConstraintDate", "Deadline", "WorkMinutes", "ActualWorkMinutes", "RemainingWorkMinutes", "BaselineWorkMinutes", "Cost", "BaselineCost", "BaselineAvailable"}),
		  #"Reordered Columns" = Table.ReorderColumns(#"Kept Errors", {"Row Number", "ProjectName", "ExtractionDate", "StatusDate", "HoursPerDay", "HoursPerWeek", "MinutesPerDay", "MinutesPerWeek", "ID", "UniqueID", "WBS", "OutlineLevel", "TaskName", "Start", "Finish", "DurationMinutes", "DurationDays", "BaselineStart", "BaselineFinish", "BaselineDurationMinutes", "BaselineDurationDays", "PercentComplete", "PhysicalPercentComplete", "ActualStart", "ActualFinish", "ActualDurationMinutes", "ActualDurationDays", "RemainingDurationMinutes", "RemainingDurationDays", "Predecessors", "Successors", "TotalSlackMinutes", "TotalSlackDays", "FreeSlackMinutes", "FreeSlackDays", "Critical", "Summary", "Milestone", "Active", "ConstraintType", "ConstraintTypeName", "ConstraintDate", "Deadline", "WorkMinutes", "ActualWorkMinutes", "RemainingWorkMinutes", "BaselineWorkMinutes", "Cost", "BaselineCost", "BaselineAvailable"}),
		    #"Removed Columns" = Table.RemoveColumns(#"Reordered Columns",{"ExtractionDate"})
		in
		  #"Removed Columns"
